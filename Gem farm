        if fuel then
            print("[Step 1." .. i .. "] Moving to fuel " .. i .. "...")
            adaptiveCrawlTo(fuel:GetPivot().Position, humanoidRootPart, character)
            task.wait(0.3)
            FuelTeleport(humanoidRootPart, fuel)
            task.wait(0.5)
            fuelsCollected = fuelsCollected + 1
        else
            print("[Step 1] No more valid fuels found. Collected " .. fuelsCollected .. "/" .. MAX_FUELS_TO_COLLECT .. ".")
            break
        end
    end
 
    -- STEP 2: OPTIMIZED POWER BOX QUERY & TRACKING (MULTI-GENERATOR SUPPORT)
    print("[Step 2] Scanning for closest Power Box models...")
    local powerBoxData = {}
    local interactionSuccess = false

    if MapFolder and MapFolder:FindFirstChild("Tiles") then
        for _, child in ipairs(MapFolder.Tiles:GetChildren()) do
            if child.Name == "Power Plant" then
                local powerBox = child:FindFirstChild("Power Box")
                if powerBox and powerBox:IsA("Model") then
                    table.insert(powerBoxData, {
                        Instance = powerBox,
                        Position = powerBox:GetPivot().Position
                    })
                end
            end
        end
    end

    if #powerBoxData > 0 then
        local currentPos = humanoidRootPart.Position
        table.sort(powerBoxData, function(a, b)
            return (currentPos - a.Position).Magnitude < (currentPos - b.Position).Magnitude
        end)

        local limit = math.min(MAX_GENERATORS_TO_FIX, #powerBoxData)
        
        for i = 1, limit do
            local chosenBox = powerBoxData[i].Instance
            local finalBoxTarget = powerBoxData[i].Position

            print("[Step 2." .. i .. "] Crawling directly to Power Box " .. i .. "...")
            adaptiveCrawlTo(finalBoxTarget, humanoidRootPart, character)
            task.wait(0.5)

            if (humanoidRootPart.Position - finalBoxTarget).Magnitude < 15 then
                local prompt = chosenBox:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    for j = 1, 3 do
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        else
                            prompt:InputHoldBegin()
                            task.wait(prompt.HoldDuration + 0.05)
                            prompt:InputHoldEnd()
                        end
                        task.wait(0.1)
                    end
                    print("[Pipeline] Interaction successfully forced on Power Box " .. i .. "!")
                    interactionSuccess = true
                end
            end
            task.wait(0.5)
        end
    end
 
    -- --- VOTE PLAY AGAIN / REJOIN SEQUENCE ---
    if interactionSuccess then
        print("[Pipeline] Ciclo concluído! Aguardando " .. REJOIN_DELAY .. " segundos antes do Rejoin...")
        task.wait(REJOIN_DELAY)
        
        local rejoinSuccess = false
        if PlayAgainRemote and PlayAgainRemote:IsA("RemoteEvent") then
            pcall(function()
                PlayAgainRemote:FireServer()
            end)
            print("[Play Again] Sequência executada com sucesso.")
            rejoinSuccess = true
        end

        if not rejoinSuccess then
            print("[Fallback] Remote falhou ou não encontrado. Tentando Rejoin forçado via TeleportService...")
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
            end)
        end
        print("Free and Keyless, script is in https://pastebin.com/V0wHqZe4")
    end
end
 
