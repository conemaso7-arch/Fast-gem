                                local dist = (hrp.Position - zombieHrp.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    closestZombie = zombie
                                end
                            end
                        end
                        
                        if closestZombie then
                            attackZombie(closestZombie)
                        end
                    end
                end
            end
            
            task.wait(ATTACK_COOLDOWN)
        end
    end)
end

