local function findZombies()
    local zombies = {}
    local playerCharacters = {}
    
    -- Coletar todos os personagens de jogadores
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            table.insert(playerCharacters, player.Character)
        end
    end
    
    -- Procurar em todo o Workspace por modelos com Humanoid
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj:FindFirstChild("HumanoidRootPart") then
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            
            -- Verificar se está vivo
            if humanoid and humanoid.Health > 0 then
                -- Verificar se NÃO é um personagem de jogador
                local isPlayer = false
                for _, playerChar in ipairs(playerCharacters) do
                    if obj == playerChar then
                        isPlayer = true
                        break
                    end
                end
                
                -- Se não é jogador, é zumbi
                if not isPlayer then
                    table.insert(zombies, obj)
                end
            end
        end
    end
    
    return zombies
end

local function equipWeapon()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return false end
    
    -- Procurar a arma específica primeiro
    local weapon = backpack:FindFirstChild(WEAPON_NAME)
    
    -- Se não achar, procurar qualquer Tool
    if not weapon then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                weapon = item
                break
            end
        end
    end
    
    if weapon then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:EquipTool(weapon)
            return true
        end
    end
    
    return false
end

local function attackZombie(zombie)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local zombieHrp = zombie:FindFirstChild("HumanoidRootPart")
    
    if not hrp or not zombieHrp then return false end
    
    local distance = (hrp.Position - zombieHrp.Position).Magnitude
    
    if distance <= ATTACK_RANGE then
        -- Tentar atacar usando firetouchinterest
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            local handle = tool:FindFirstChild("Handle")
            if handle then
                pcall(function()
                    firetouchinterest(handle, zombieHrp, 0)
                    task.wait(0.05)
                    firetouchinterest(handle, zombieHrp, 1)
                end)
                return true
            end
        end
        
        -- Fallback: tentar encontrar RemoteEvent de ataque
        local attackRemote = ReplicatedStorage:FindFirstChild("Attack", true) or 
                           ReplicatedStorage:FindFirstChild("Combat", true) or
                           ReplicatedStorage:FindFirstChild("Hit", true)
        
        if attackRemote and attackRemote:IsA("RemoteEvent") then
            pcall(function()
                attackRemote:FireServer(zombie)
            end)
            return true
        end
    end
    
    return false
end

local function startAutoCombat()
    task.spawn(function()
        while AUTO_COMBAT_ENABLED do
            if character and character.Parent then
                local zombies = findZombies()
                
                if #zombies > 0 then
                    -- Equipar arma se não estiver equipado
                    local currentTool = character:FindFirstChildOfClass("Tool")
                    if not currentTool then
